# Postgres do Railway (projeto agenda-diana). Sem isto, usa SQLite local (agenda.db).
DATABASE_URL=postgresql://usuario:senha@host:porta/railway
# Senha do painel da Diana (/painel)
ADMIN_SENHA=troque-esta-senha
# Segredo dos cookies de sessão (texto longo e aleatório)
SECRET_KEY=troque-por-um-texto-longo-aleatorio
